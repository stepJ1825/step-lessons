{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2025
    },
    "available": {
      "type": "boolean"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "isbn": {
      "type": ["string", "null"],
      "pattern": "^(?:ISBN(?:-1[03])?:? )?(?=[-0-9xX ]{13,17}$)(?:97(?:8|9)[- ]?)?[0-9]{1,5}[- ]?(?:[0-9]+[- ]?){2}[0-9xX]?$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 2
        },
        "founded": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2025
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": ["name", "country"],
      "additionalProperties": false
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "translator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["language", "title", "translator"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metadata": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "hasIllustrations": {
          "type": "boolean"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": false
        }
      },
      "required": ["pages", "dimensions", "hasIllustrations", "reviews"],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "author",
    "year",
    "available",
    "rating",
    "tags",
    "publisher",
    "translations",
    "metadata"
  ],
  "additionalProperties": false
}